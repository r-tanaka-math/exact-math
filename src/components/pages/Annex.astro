---
import { SITE } from '../../config';
import Sections from '../Sections.astro';
import Contents from '../Contents.astro';
import Link from '../Link.astro';
import {publicWording} from '../../lib/build-profile';
const c = SITE.annex;
---
<header class="page-head"><p class="eyebrow">{c.eyebrow}</p><h1>{c.title}</h1><p class="lead">{c.lead}</p><p class="intro">{c.intro}</p></header><div class="notice">{publicWording ? 'MathlibAnnex v0.2.0 source: public. Mankiewicz: 11 public canonical Cards and Project HTML/PDF/JSON. Sphere Rigidity: 0 public Cards; Research Companion available. LFH content terms: effective.' : c.status}</div><p><a href={import.meta.env.BASE_URL+'mathlibannex/releases/v0.2.0/'}>Current MathlibAnnex v0.2.0 source release</a> · <a href={import.meta.env.BASE_URL+'mathlibannex/releases/v0.1.0/'}>Historical v0.1.0 source release</a></p><section id="lfh-definition"><p>Lean for Human (LFH) is the human-readable layer accompanying selected Lean declarations: declaration cards, exact source links, and guided Project views.</p><p>Project views organize routes through exact source declarations. A declaration Card belongs to the whole-library Catalog; Project ordering is a reading route, not canonical library order. {publicWording ? 'The current Catalog contains eleven public Cards, all referenced by the Mankiewicz Project. Sphere Rigidity has zero public Cards.' : 'The present views are available for local content review.'}</p><p><a href={import.meta.env.BASE_URL+'mathlibannex/catalog/'}>Browse the whole-library Catalog</a> · <a href={import.meta.env.BASE_URL+'mathlibannex/overviews/mankiewicz/'}>Mankiewicz overview</a> · <a href={import.meta.env.BASE_URL+'mathlibannex/projects/mankiewicz/'}>Mankiewicz Project</a> · <a href={import.meta.env.BASE_URL+'mathlibannex/verification/'}>Card verification contract</a></p></section>
<div class="reading-layout"><article class="article"><Sections items={c.sections}/><section id="work"><h2>Two concrete starting points.</h2><div class="work-grid"><article class="work-item"><h3>Mankiewicz Theorem Project</h3><p>{publicWording ? 'A derived proof route through the eleven public canonical Declaration Cards, with prerequisites, used-by navigation, exact source and a three-page PDF.' : c.work[0].text}</p><a href={import.meta.env.BASE_URL+'mathlibannex/projects/mankiewicz/'}>{publicWording ? 'Open the Project' : 'Open the local Project view'}</a></article><article class="work-item"><h3>Sphere Rigidity Research Companion</h3><p>{publicWording ? 'A progressive Research Companion with 467 exact declaration nodes and zero public Cards.' : c.work[1].text}</p><a href={import.meta.env.BASE_URL+'mathlibannex/projects/sphere-rigidity/'}>{publicWording ? 'Open the Companion' : 'Open the local Companion'}</a></article></div></section><section><p>{c.closing}</p><Link to="research" label="Return to the research"/></section></article><Contents items={[{id:'mathlib-first',label:'Mathlib first'},{id:'cards',label:'Declaration cards'},{id:'reading',label:'Reading the proof'},{id:'work',label:'Starting points'}]} note="The Catalog records Card identity; Project views provide reading routes."/></div>
