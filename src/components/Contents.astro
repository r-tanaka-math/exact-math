---
interface Props { items: {id:string;label?:string;title?:string}[]; note?: string }
const { items, note } = Astro.props;
---
<aside><nav class="contents" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p>{items.map(s => <a href={`#${s.id}`}>{s.label || s.title}</a>)}{note && <p>{note}</p>}</nav></aside>
