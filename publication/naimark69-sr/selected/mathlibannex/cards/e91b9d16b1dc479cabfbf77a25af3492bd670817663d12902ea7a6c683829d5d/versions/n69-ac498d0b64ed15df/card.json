  "source_signature": {
    "text": "theorem traceExtension_mul_comm (family : RepresentativeShellFamily)\n    (a b : ShellFamilyTarget family) :\n    traceExtension family (a * b) = traceExtension family (b * a)",
    "source_path": "MathlibAnnex/Analysis/CStarAlgebra/CAR/TraceExtensionTracial.lean",
    "source_sha256": "113279f9d1a887018cf2cc00dbdb3682d413c4aeca1e1d9e0f9a65dd17cfdd5a",
