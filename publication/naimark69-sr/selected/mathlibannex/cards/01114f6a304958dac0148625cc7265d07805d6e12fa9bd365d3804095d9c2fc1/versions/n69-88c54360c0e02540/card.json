  "source_signature": {
    "text": "theorem exists_unitVector_vectorFunctional_eq_on_stage\n    {H K : Type*}\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\n    [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]\n    (ρ : Representation Limit H) (hρ : ρ.IsIrreducible)\n    (σ : Representation Limit K) (n : ℕ) (η : K) (hη : ‖η‖ = 1) :\n    ∃ ξ : H, ‖ξ‖ = 1 ∧ ∀ c : Stage n,\n      Representation.vectorFunctional ρ ξ (ofStage n c) =\n        Representation.vectorFunctional σ η (ofStage n c)",
