    "start_byte": 560,
    "text": "theorem exists_character_annihilating_closedIdeal_of_not_mem\n    {D : Type u} [CommCStarAlgebra D]\n    (J : Ideal D) (hJclosed : IsClosed (J : Set D))\n    {d : D} (hd : d ∉ J) :\n    ∃ chi : WeakDual.characterSpace ℂ D,\n      (∀ x : D, x ∈ J → chi x = 0) ∧ chi d ≠ 0"
  },
