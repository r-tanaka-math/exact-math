  "source_signature": {
    "text": "noncomputable def traceModelRepresentation (family : RepresentativeShellFamily) :\n    Representation (ShellFamilyTarget family) TraceHilbertSpace :=\n  (traceGNSUnitary family).symm.conjStarAlgEquiv.toStarAlgHom.comp\n    (tracialRepresentation family)",
    "start_byte": 4846,
    "end_byte": 5096,
    "sha256": "ab07f8caf89b3e2a6decfd742272c415341eaf45550bfa8fef3ad47077cae2f3",
    "source_path": "MathlibAnnex/Analysis/CStarAlgebra/CAR/TraceGNSModel.lean",
