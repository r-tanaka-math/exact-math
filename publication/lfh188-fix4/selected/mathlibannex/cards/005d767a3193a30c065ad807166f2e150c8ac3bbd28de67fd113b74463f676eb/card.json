    },
    {
      "step_id": "source_equation",
      "text": "IsMaximalAbelian D ↔ IsMulCommutative D ∧ ∀ E, IsMulCommutative E → D ≤ E → E ≤ D."
    },
    {
      "step_id": "source_route",
      "text": "This definition does not itself add a closedness conjunct. Closedness, when needed later, comes from a separate theorem about maximal abelian subalgebras."
    }
