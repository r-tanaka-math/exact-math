  "name": "MathlibAnnex.Analysis.CStarAlgebra.IsMaximalAbelian",
  "natural_language_statement": "Let D be a unital star subalgebra of a unital complex C*-algebra A. D is commutative, and any commutative unital star subalgebra E containing D is contained in D; thus D is maximal for inclusion among such subalgebras.",
  "one_sentence_role": "Defines maximal abelian unital star subalgebras by commutativity and maximality under inclusion.",
  "owner_review_item_sha256": "cf0685e63042f97e2c991cd091f7c8b2222e7959167f4452557f8e08d17e7c63",
  "proof_steps": [
