  "source_signature": {
    "text": "noncomputable def tracialRepresentation (family : RepresentativeShellFamily) :\n    Representation (ShellFamilyTarget family) (TracialHilbertSpace family) :=\n  (traceExtensionPositive family).gnsStarAlgHom",
