module

public import MathlibAnnex.Topology.ClosureSpace.Maps
public import Mathlib.Logic.Relation

/-!
# Components generated by nonclosed pairs

The equivalence closure is the existing `Relation.EqvGen`. The generating relation
is symmetric; hence it describes exactly finite chains of nonclosed pairs, with
identity steps allowed. The component and its closure are kept separate.
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace ClosureSpace

variable {α : Type u} {β : Type v}

/-- Equality or a nonclosed two-point set. -/
def Linked (c : ClosureSpace α) (x y : α) : Prop := x = y ∨ ¬ c.IsClosed {x, y}

theorem linked_refl (c : ClosureSpace α) (x : α) : c.Linked x x := Or.inl rfl

theorem linked_symm (c : ClosureSpace α) {x y : α} (h : c.Linked x y) :
    c.Linked y x := by
  rcases h with h | h
  · exact Or.inl h.symm
  · apply Or.inr
    intro hyx
    apply h
    have hset : ({x, y} : Set α) = {y, x} := by
      apply Set.ext
      intro z
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, or_comm]
    rw [hset]
    exact hyx

/-- The equivalence relation generated by linked pairs. -/
def componentSetoid (c : ClosureSpace α) : Setoid α := Relation.EqvGen.setoid c.Linked

/-- Belonging to the same finite-chain component. -/
abbrev Related (c : ClosureSpace α) (x y : α) : Prop := (c.componentSetoid).r x y

theorem related_refl (c : ClosureSpace α) (x : α) : c.Related x x :=
  c.componentSetoid.iseqv.refl x

theorem related_symm (c : ClosureSpace α) {x y : α} (h : c.Related x y) :
    c.Related y x := c.componentSetoid.iseqv.symm h

theorem related_trans (c : ClosureSpace α) {x y z : α}
    (hxy : c.Related x y) (hyz : c.Related y z) : c.Related x z :=
  c.componentSetoid.iseqv.trans hxy hyz

theorem related_of_linked (c : ClosureSpace α) {x y : α} (h : c.Linked x y) :
    c.Related x y := Relation.EqvGen.rel x y h

/-- The equivalence class as an ambient subset. -/
def component (c : ClosureSpace α) (x : α) : Set α := {y | c.Related x y}

theorem mem_component (c : ClosureSpace α) (x : α) : x ∈ c.component x :=
  c.related_refl x

theorem component_eq_of_related (c : ClosureSpace α) {x y : α} (h : c.Related x y) :
    c.component x = c.component y := by
  apply Set.ext
  intro z
  exact ⟨fun hxz => c.related_trans (c.related_symm h) hxz,
    fun hyz => c.related_trans h hyz⟩

/-- The closure of a component, not the component itself. -/
def componentClosure (c : ClosureSpace α) (x : α) : Set α := c.closure (c.component x)

theorem mem_componentClosure (c : ClosureSpace α) (x : α) : x ∈ c.componentClosure x :=
  c.subset_closure (c.component x) (c.mem_component x)

/-- Finite continuity preserves linked pairs when the map is injective.
The injectivity assumption is essential. -/
theorem FinitelyContinuous.linked {c : ClosureSpace α} {d : ClosureSpace β}
    {f : α → β} (hf : c.FinitelyContinuous d f) (hinj : Function.Injective f)
    {x y : α} (hxy : c.Linked x y) : d.Linked (f x) (f y) := by
  rcases hxy with hxy | hxy
  · exact Or.inl (congrArg f hxy)
  · apply Or.inr
    intro hclosed
    apply hxy
    apply (c.isClosed_iff_closure_subset {x, y}).2
    intro z hz
    have hz' := hf {x, y} ((Set.finite_singleton y).insert x) ⟨z, hz, rfl⟩
    rw [Set.image_pair, (d.isClosed_iff {f x, f y}).1 hclosed] at hz'
    rcases Set.mem_insert_iff.1 hz' with hx | hy
    · exact Set.mem_insert_iff.2 (Or.inl (hinj hx))
    · exact Set.mem_insert_iff.2
        (Or.inr (Set.mem_singleton_iff.2 (hinj (Set.mem_singleton_iff.1 hy))))

/-- An injective finitely continuous map preserves the equivalence closure. -/
theorem FinitelyContinuous.related {c : ClosureSpace α} {d : ClosureSpace β}
    {f : α → β} (hf : c.FinitelyContinuous d f) (hinj : Function.Injective f)
    {x y : α} (hxy : c.Related x y) : d.Related (f x) (f y) := by
  change Relation.EqvGen c.Linked x y at hxy
  change Relation.EqvGen d.Linked (f x) (f y)
  induction hxy with
  | rel a b hab => exact Relation.EqvGen.rel _ _ (hf.linked hinj hab)
  | refl a => exact Relation.EqvGen.refl _
  | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans a b z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

theorem FiniteHomeomorph.related_iff {c : ClosureSpace α} {d : ClosureSpace β}
    (h : FiniteHomeomorph c d) (x y : α) :
    d.Related (h.toEquiv x) (h.toEquiv y) ↔ c.Related x y := by
  constructor
  · intro hxy
    have h' := h.finitelyContinuous_invFun.related h.toEquiv.symm.injective hxy
    change c.Related (h.toEquiv.symm (h.toEquiv x)) (h.toEquiv.symm (h.toEquiv y)) at h'
    simpa only [Equiv.symm_apply_apply] using h'
  · exact h.finitelyContinuous_toFun.related h.toEquiv.injective

theorem FiniteHomeomorph.image_component {c : ClosureSpace α} {d : ClosureSpace β}
    (h : FiniteHomeomorph c d) (x : α) :
    h.toEquiv '' c.component x = d.component (h.toEquiv x) := by
  apply Set.ext
  intro y
  constructor
  · rintro ⟨z, hz, rfl⟩
    exact (h.related_iff x z).2 hz
  · intro hy
    refine ⟨h.toEquiv.symm y, ?_, h.toEquiv.apply_symm_apply y⟩
    apply (h.related_iff x (h.toEquiv.symm y)).1
    change d.Related (h.toEquiv x) y at hy
    simpa only [Equiv.apply_symm_apply] using hy

theorem Homeomorph.image_componentClosure {c : ClosureSpace α} {d : ClosureSpace β}
    (h : Homeomorph c d) (x : α) :
    h.toEquiv '' c.componentClosure x = d.componentClosure (h.toEquiv x) := by
  change h.toEquiv '' c.closure (c.component x) =
    d.closure (d.component (h.toEquiv x))
  rw [h.image_closure]
  change d.closure (h.toFiniteHomeomorph.toEquiv '' c.component x) =
    d.closure (d.component (h.toFiniteHomeomorph.toEquiv x))
  rw [h.toFiniteHomeomorph.image_component]

end ClosureSpace
