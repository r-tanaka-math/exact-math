/-!
# Orthogonal elementary ideals and norm-dense finite sums

Let `A` admit a faithful representation whose represented operators are all
compact.  The preceding generated-ideal development shows that the closed ideal
generated by a minimal projection is an exact algebraic model of the compact
operators on its cyclic Hilbert space.  This file supplies the next global
step.

* the closed ideal generated by a minimal projection is a minimal nonzero
  closed ideal;
* the actual family of all minimal nonzero closed ideals is pairwise
  orthogonal, and every member has an exact compact-operator model;
* compact spectral truncation produces source projections of finite
  represented rank and gives operator-norm approximation by right cutoffs;
* a finite-rank source projection is a finite sum of mutually orthogonal
  minimal projections, so every right cutoff belongs to an actual finite sum
  of members of the minimal-ideal family;
* those actual finite sums are norm dense in `A`.

The density proof is quantitative.  It does not replace approximation by a
maximality argument or by the statement that a common annihilator is zero.
The index type is the subtype of all minimal nonzero closed ideals; it can be
empty in the zero algebra and no separability or countability assumption is
made.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section

open Set Metric Module Module.End
open scoped CStarAlgebra ComplexConjugate Topology

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v
variable {A : Type u} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

namespace ClosedStarIdeal

/-- Extensionality for concrete closed star ideals.  The absorption and
closedness fields are propositions, so equality is determined by the carrier. -/
@[ext]
theorem ext {I J : ClosedStarIdeal A}
    (h : I.toNonUnitalStarSubalgebra = J.toNonUnitalStarSubalgebra) : I = J := by
  cases I with
  | mk I hIc hIl hIr =>
      cases J with
      | mk J hJc hJl hJr =>
          cases h
          rfl

/-- A closed star ideal is nonzero when its carrier contains a nonzero
ambient element. -/
def IsNonzero (I : ClosedStarIdeal A) : Prop :=
  ∃ x : I.toNonUnitalStarSubalgebra, x ≠ 0

/-- A minimal nonzero closed star ideal has no proper nonzero closed subideal.
The order is the literal inclusion of the underlying star subalgebras. -/
def IsMinimalNonzero (I : ClosedStarIdeal A) : Prop :=
  I.IsNonzero ∧
    ∀ J : ClosedStarIdeal A,
      J.toNonUnitalStarSubalgebra ≤ I.toNonUnitalStarSubalgebra →
      J.IsNonzero → J = I

namespace IsMinimalNonzero

variable {I : ClosedStarIdeal A}

/-- A minimal nonzero ideal is nonzero. -/
theorem isNonzero (hI : I.IsMinimalNonzero) : I.IsNonzero := hI.1

/-- Any nonzero closed subideal of a minimal ideal is the whole ideal. -/
theorem eq_of_le (hI : I.IsMinimalNonzero) {J : ClosedStarIdeal A}
    (hJI : J.toNonUnitalStarSubalgebra ≤ I.toNonUnitalStarSubalgebra)
    (hJ0 : J.IsNonzero) : J = I :=
  hI.2 J hJI hJ0

end IsMinimalNonzero

end ClosedStarIdeal

/-- The canonical index type for the global elementary-ideal family: all
minimal nonzero norm-closed two-sided star ideals of `A`. -/
def MinimalClosedStarIdeal (A : Type u) [NonUnitalCStarAlgebra A] : Type u :=
  {I : ClosedStarIdeal A // I.IsMinimalNonzero}

/-- The actual closed ideal indexed by a member of
`MinimalClosedStarIdeal A`. -/
def minimalClosedStarIdealFamily
    (i : MinimalClosedStarIdeal A) : ClosedStarIdeal A :=
  i.1

end MathlibAnnex.Analysis.CStarAlgebra

universe u v
variable {A : Type u} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]


namespace MathlibAnnex.Analysis.CStarAlgebra

namespace NonUnitalCStarRepresentation

/-- The source peak attached to any prescribed isolated nonzero spectral point
is a finite-rank star projection.  Unlike the existential predecessor, the
spectral point and isolation radius are inputs, so finitely many such
projections can be summed in one source element. -/
theorem compactSpectralProjection_spec
    (pi : NonUnitalCStarRepresentation A H) (hpi : Function.Injective pi)
    (a : A) (ha : 0 ≤ a) (hcompact : IsCompactOperator (pi a))
    {μ : ℂ} (hμspec : μ ∈ spectrum ℂ (pi a)) (hμ0 : μ ≠ 0)
    {r : ℝ} (hr : 0 < r) (hrμ : r ≤ ‖μ‖)
    (hiso : ∀ z ∈ spectrum ℂ (pi a), z ≠ μ → r ≤ dist z μ) :
    let p := pi.compactSpectralProjection a μ r
    IsStarProjection p ∧ p ≠ 0 ∧
      FiniteDimensional ℂ (LinearMap.range (pi p).toLinearMap) ∧
      pi p = cfc (compactSpectralPeak μ r) (pi a) := by
  let f : ℂ → ℂ := compactSpectralPeak μ r
  let p : A := pi.compactSpectralProjection a μ r
  let q : H →L[ℂ] H := cfc f (pi a)
  have haSelf : IsSelfAdjoint a := IsSelfAdjoint.of_nonneg ha
  have hf : Continuous f := compactSpectralPeak.continuous hr
  have hmap : pi p = q := by
    exact pi.compactSpectralProjection_apply a haSelf.isStarNormal μ hr hrμ
  have hqIdem : IsIdempotentElem q := by
    rw [IsIdempotentElem]
    change q * q = q
    rw [show q * q = cfc (fun z => f z * f z) (pi a) by
      exact (cfc_mul f f (pi a) hf.continuousOn hf.continuousOn).symm]
    apply cfc_congr
    intro z hz
    rcases compactSpectralPeak.apply_eq_zero_or_one_on_isolated_spectrum
      hr hμspec hiso hz with hz0 | hz1
    · simp only [f, hz0, zero_mul]
    · simp only [f, hz1, one_mul]
  have hqProj : IsStarProjection q :=
    isStarProjection_iff_isIdempotentElem_and_isStarNormal.mpr
      ⟨hqIdem, cfc_predicate f (pi a)⟩
  have hpIdem : IsIdempotentElem p := by
    rw [IsIdempotentElem]
    apply hpi
    rw [map_mul, hmap, hqIdem.eq]
  have hpProj : IsStarProjection p :=
    isStarProjection_iff_isIdempotentElem_and_isStarNormal.mpr
      ⟨hpIdem, cfcₙ_predicate f a⟩
  have hq0 : q ≠ 0 := by
    intro hq
    have h1 : (1 : ℂ) ∈ spectrum ℂ q := by
      rw [cfc_map_spectrum f (pi a) (haSelf.map pi).isStarNormal hf.continuousOn]
      exact ⟨μ, hμspec, compactSpectralPeak.apply_center hr.ne'⟩
    obtain ⟨x, _, hx0⟩ :=
      ((hcompact.hasEigenvalue_iff_mem_spectrum hμ0).2 hμspec).exists_hasEigenvector
    letI : Nontrivial H := ⟨⟨x, 0, hx0⟩⟩
    rw [hq, CFC.spectrum_zero_eq (R := ℂ)] at h1
    exact one_ne_zero (Set.mem_singleton_iff.mp h1)
  have hp0 : p ≠ 0 := fun hp => hq0 (by rw [← hmap, hp, map_zero])
  have hTq : (pi a) * q = μ • q := by
    calc
      (pi a) * q = cfc (fun z : ℂ => z * f z) (pi a) := by
        have hmul := cfc_mul (fun z : ℂ => z) f (pi a)
          continuousOn_id hf.continuousOn
        rw [cfc_id' ℂ (pi a) (haSelf.map pi).isStarNormal] at hmul
        exact hmul.symm
      _ = cfc (fun z : ℂ => μ * f z) (pi a) := by
        apply cfc_congr
        intro z hz
        rcases compactSpectralPeak.apply_eq_zero_or_one_on_isolated_spectrum
          hr hμspec hiso hz with hz0 | hz1
        · simp only [f, hz0, mul_zero]
        · have hzμ : z = μ := by
            by_contra h
            have hzzero :=
              compactSpectralPeak.apply_eq_zero_of_le_dist hr (hiso z hz h)
            exact one_ne_zero (hz1.symm.trans hzzero)
          simp [hzμ, hz1]
      _ = μ • q := by
        simpa [q] using cfc_smul μ f (pi a) hf.continuousOn
  have hrange : LinearMap.range q.toLinearMap ≤
      Module.End.eigenspace (pi a).toLinearMap μ := by
    rintro y ⟨x, rfl⟩
    rw [Module.End.mem_eigenspace_iff]
    simpa [ContinuousLinearMap.mul_apply] using
      congrArg (fun T : H →L[ℂ] H => T x) hTq
  letI : FiniteDimensional ℂ
      (Module.End.eigenspace (pi a).toLinearMap μ) :=
    ContinuousLinearMap.finite_dimensional_eigenspace hcompact μ hμ0
  have hfinite : FiniteDimensional ℂ (LinearMap.range q.toLinearMap) :=
    Submodule.finiteDimensional_of_le hrange
  have hfinite' : FiniteDimensional ℂ
      (LinearMap.range (pi p).toLinearMap) := by
    rw [hmap]
    exact hfinite
  exact ⟨hpProj, hp0, hfinite', hmap⟩

/-- A positive source element in a faithful compact representation admits a
finite-rank spectral cutoff from the source algebra.  The cutoff commutes with
the element and right multiplication by it approximates the element in the
original C-star norm. -/
theorem exists_finite_rank_spectral_projection_norm_sub_mul_lt
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented)
    (a : A) (ha : 0 ≤ a) {ε : ℝ} (hε : 0 < ε) :
    ∃ q : A,
      IsStarProjection q ∧
      FiniteDimensional ℂ (LinearMap.range (pi q).toLinearMap) ∧
      Commute a q ∧ ‖a - a * q‖ < ε := by
  classical
  let T : H →L[ℂ] H := pi a
  have haSelf : IsSelfAdjoint a := IsSelfAdjoint.of_nonneg ha
  have hTself : T.IsSymmetric := (haSelf.map pi).isSymmetric
  have hTcompact : IsCompactOperator T := hpi.2 a
  let δ : ℝ := ε / 2
  have hδ : 0 < δ := half_pos hε
  let S : Set ℂ := {z : ℂ | z ∈ spectrum ℂ T ∧ δ ≤ ‖z‖}
  have hSfinite : S.Finite := by
    exact T.finite_spectrum_norm_ge hTcompact hTself hδ
  letI : Fintype S := hSfinite.fintype
  have hμ0 (μ : S) : (μ : ℂ) ≠ 0 := by
    intro hzero
    have := μ.property.2
    rw [hzero, norm_zero] at this
    exact (not_le_of_gt hδ) this
  have hμeig (μ : S) : HasEigenvalue (T : Module.End ℂ H) (μ : ℂ) :=
    (hTcompact.hasEigenvalue_iff_mem_spectrum (hμ0 μ)).2 μ.property.1
  have hisol (μ : S) :
      ∃ r : ℝ, 0 < r ∧ r < ‖(μ : ℂ)‖ ∧
        ∀ z ∈ spectrum ℂ T, z ≠ (μ : ℂ) → r ≤ dist z (μ : ℂ) :=
    T.exists_isolated_spectrum_radius_of_hasEigenvalue
      hTcompact hTself (hμ0 μ) (hμeig μ)
  choose r hr hrμ hiso using hisol
  let peak : S → ℂ → ℂ := fun μ => compactSpectralPeak (μ : ℂ) (r μ)
  let p : S → A := fun μ => pi.compactSpectralProjection a (μ : ℂ) (r μ)
  let f : ℂ → ℂ := fun z => ∑ μ : S, peak μ z
  let q : A := ∑ μ : S, p μ
  have hpeakContinuous (μ : S) : Continuous (peak μ) :=
    compactSpectralPeak.continuous (hr μ)
  have hpeakZero (μ : S) : peak μ 0 = 0 :=
    compactSpectralPeak.apply_zero (hr μ) (hrμ μ).le
  have hpSpec (μ : S) :
      IsStarProjection (p μ) ∧ p μ ≠ 0 ∧
        FiniteDimensional ℂ (LinearMap.range (pi (p μ)).toLinearMap) ∧
        pi (p μ) = cfc (peak μ) T := by
    exact pi.compactSpectralProjection_spec hpi.1 a ha hTcompact
      μ.property.1 (hμ0 μ) (hr μ) (hrμ μ).le (hiso μ)
  have hfContinuous : Continuous f := by
    unfold f
    fun_prop
  have hf0 : f 0 = 0 := by
    simp [f, hpeakZero]
  have hf_on_spectrum {z : ℂ} (hz : z ∈ spectrum ℂ T) :
      f z = if δ ≤ ‖z‖ then 1 else 0 := by
    by_cases hzδ : δ ≤ ‖z‖
    · let μ : S := ⟨z, hz, hzδ⟩
      have hmain : peak μ z = 1 := by
        simpa [peak, μ] using compactSpectralPeak.apply_center (hr μ).ne'
      have hother : ∀ ν : S, ν ≠ μ → peak ν z = 0 := by
        intro ν hν
        have hzν : z ≠ (ν : ℂ) := by
          intro h
          apply hν
          apply Subtype.ext
          exact h.symm
        exact compactSpectralPeak.apply_eq_zero_of_le_dist
          (hr ν) (hiso ν z hz hzν)
      rw [if_pos hzδ]
      calc
        f z = ∑ ν : S, peak ν z := rfl
        _ = peak μ z := Finset.sum_eq_single μ
          (fun ν _ hν => hother ν hν)
          (fun hμmem => (hμmem (Finset.mem_univ μ)).elim)
        _ = 1 := hmain
    · have hzero : ∀ μ : S, peak μ z = 0 := by
        intro μ
        have hzμ : z ≠ (μ : ℂ) := by
          intro h
          subst z
          exact hzδ μ.property.2
        exact compactSpectralPeak.apply_eq_zero_of_le_dist
          (hr μ) (hiso μ z hz hzμ)
      rw [if_neg hzδ]
      simp [f, hzero]
  have hq_cfc : q = cfcₙ f a := by
    calc
      q = ∑ μ : S, cfcₙ (peak μ) a := by rfl
      _ = cfcₙ (∑ μ : S, peak μ) a := by
        symm
        exact cfcₙ_sum_univ peak a
          (fun μ => (hpeakContinuous μ).continuousOn)
          hpeakZero
      _ = cfcₙ f a := by
        congr 1
        ext z
        simp only [f, Finset.sum_apply]
  have hpiq : pi q = cfc f T := by
    rw [hq_cfc]
    exact pi.map_cfcₙ_eq_cfc_normal a haSelf.isStarNormal f hfContinuous hf0
  have hqIdem : IsIdempotentElem q := by
    rw [IsIdempotentElem]
    apply hpi.1
    rw [map_mul, hpiq]
    change cfc f T * cfc f T = cfc f T
    rw [show cfc f T * cfc f T = cfc (fun z => f z * f z) T by
      exact (cfc_mul f f T hfContinuous.continuousOn
        hfContinuous.continuousOn).symm]
    apply cfc_congr
    intro z hz
    simp only [hf_on_spectrum hz]
    split_ifs <;> simp
  have hqNormal : IsStarNormal q := by
    rw [hq_cfc]
    exact cfcₙ_predicate f a
  have hqProj : IsStarProjection q :=
    isStarProjection_iff_isIdempotentElem_and_isStarNormal.mpr
      ⟨hqIdem, hqNormal⟩
  have hpiqSum : pi q = ∑ μ : S, pi (p μ) := by
    simp [q]
  have hrange : LinearMap.range (pi q).toLinearMap ≤
      ⨆ μ : S, LinearMap.range (pi (p μ)).toLinearMap := by
    rw [hpiqSum]
    rintro y ⟨x, rfl⟩
    change (∑ μ : S, pi (p μ)) x ∈ _
    rw [ContinuousLinearMap.sum_apply]
    exact Submodule.sum_mem _ fun μ _ =>
      (le_iSup (fun ν : S => LinearMap.range (pi (p ν)).toLinearMap) μ)
        ⟨x, rfl⟩
  letI hfin : (μ : S) → FiniteDimensional ℂ
      (LinearMap.range (pi (p μ)).toLinearMap) :=
    fun μ => (hpSpec μ).2.2.1
  letI : FiniteDimensional ℂ
      ↥(⨆ μ : S, LinearMap.range (pi (p μ)).toLinearMap : Submodule ℂ H) := by
    infer_instance
  have hqfin : FiniteDimensional ℂ
      (LinearMap.range (pi q).toLinearMap) :=
    Submodule.finiteDimensional_of_le hrange
  have hcomm : Commute a q := by
    have h := cfcₙ_commute_cfcₙ (fun z : ℂ => z) f a
    rw [cfcₙ_id' ℂ a haSelf.isStarNormal] at h
    simpa only [hq_cfc] using h
  have herrorMap : pi (a - a * q) =
      cfc (fun z : ℂ => z - z * f z) T := by
    calc
      pi (a - a * q) = T - T * cfc f T := by
        rw [map_sub, map_mul, hpiq]
      _ = cfc (fun z : ℂ => z - z * f z) T := by
        symm
        rw [cfc_sub (f := fun z : ℂ => z) (g := fun z => z * f z)
          (a := T) (hf := continuousOn_id)
          (hg := continuousOn_id.mul hfContinuous.continuousOn)]
        rw [cfc_mul (fun z : ℂ => z) f T
          continuousOn_id hfContinuous.continuousOn]
        rw [cfc_id' ℂ T (haSelf.map pi).isStarNormal]
  have hboundLe : ‖cfc (fun z : ℂ => z - z * f z) T‖ ≤ δ := by
    apply norm_cfc_le hδ.le
    intro z hz
    rw [hf_on_spectrum hz]
    by_cases hzδ : δ ≤ ‖z‖
    · rw [if_pos hzδ]
      simpa using hδ.le
    · rw [if_neg hzδ]
      simp only [mul_zero, sub_zero]
      exact (lt_of_not_ge hzδ).le
  have hbound : ‖cfc (fun z : ℂ => z - z * f z) T‖ < ε :=
    hboundLe.trans_lt (by dsimp only [δ]; exact half_lt_self hε)
  have hnorm : ‖a - a * q‖ = ‖pi (a - a * q)‖ :=
    (NonUnitalStarAlgHom.norm_map pi hpi.1 (a - a * q)).symm
  refine ⟨q, hqProj, hqfin, hcomm, ?_⟩
  rw [hnorm, herrorMap]
  exact hbound

end NonUnitalCStarRepresentation

end MathlibAnnex.Analysis.CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

/-- The closed ideal generated by an ambient minimal projection is a minimal
nonzero closed ideal.  The proof uses the already established exact cyclic
compact model of this very generated ideal.  A nonzero subideal element is
sandwiched with a represented rank-one operator to produce a nonzero element
of the scalar corner, forcing the generator itself into the subideal. -/
theorem isMinimalNonzero_closedIdealGeneratedBy
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) :
    (closedIdealGeneratedBy p).IsMinimalNonzero := by
  constructor
  · exact exists_ne_zero_mem_closedIdealGeneratedBy hp.ne_zero
  · intro K hKp hK0
    apply ClosedStarIdeal.ext
    apply le_antisymm
    · exact hKp
    · apply closedIdealGeneratedBy_le p K
      obtain ⟨aK, haK0⟩ := hK0
      obtain ⟨x, hx0, hpx, -, -⟩ :=
        pi.exists_fixed_nonzero_compact_restrictClosedIdealGeneratedByCyclic
          hpi hp.isStarProjection hp.ne_zero
      let Jp := (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra
      let sigma : NonUnitalCStarRepresentation Jp H :=
        pi.restrictClosedIdealGeneratedBy p
      let M : Submodule ℂ H := sigma.cyclicSubspace x
      let rho : NonUnitalCStarRepresentation Jp M :=
        pi.restrictClosedIdealGeneratedByCyclic p x
      let pJ : Jp := ⟨p, self_mem_closedIdealGeneratedBy p⟩
      let aJ : Jp := ⟨aK.1, hKp aK.2⟩
      let v : M := M.orthogonalProjectionOnto x
      have hxM : x ∈ M := by
        rw [← hpx]
        exact sigma.apply_mem_cyclicSubspace x pJ
      have hvEq : v = ⟨x, hxM⟩ :=
        M.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hxM⟩
      have hv0 : v ≠ 0 := by
        intro hv
        apply hx0
        have := congrArg Subtype.val hv
        simpa [hvEq] using this
      have hvfix : rho pJ v = v := by
        apply Subtype.ext
        change pi p (v : H) = (v : H)
        have hvcoe : (v : H) = x := congrArg Subtype.val hvEq
        rw [hvcoe, hpx]
      have haJ0 : aJ ≠ 0 := by
        intro ha
        apply haK0
        apply Subtype.ext
        exact congrArg (fun b : Jp => (b : A)) ha
      have hmodel : IsCompactOperatorModel rho :=
        pi.isCompactOperatorModel_restrictClosedIdealGeneratedByCyclic
          hpi hp hx0 hpx
      have hrhoa0 : rho aJ ≠ 0 := by
        intro hzero
        exact haJ0 (hmodel.1 (by simpa only [map_zero] using hzero))
      obtain ⟨z, hz⟩ : ∃ z : M, rho aJ z ≠ 0 := by
        by_contra h
        push_neg at h
        apply hrhoa0
        apply ContinuousLinearMap.ext
        intro z
        simpa only [ContinuousLinearMap.zero_apply] using h z
      let w : M := rho aJ z
      have hw0 : w ≠ 0 := by simpa only [w] using hz
      let c : ℂ := inner ℂ w w
      have hc0 : c ≠ 0 := by
        intro hc
        exact hw0 (inner_self_eq_zero.mp hc)
      let S : M →L[ℂ] M :=
        c⁻¹ • InnerProductSpace.rankOne ℂ v w
      have hSw : S w = v := by
        change c⁻¹ • (inner ℂ w w • v) = v
        change c⁻¹ • (c • v) = v
        rw [smul_smul, inv_mul_cancel₀ hc0, one_smul]
      have hScompact : IsCompactOperator S :=
        (InnerProductSpace.isCompactOperator_rankOne v w).smul c⁻¹
      obtain ⟨bJ, hbJ⟩ := hmodel.2.2 S hScompact
      let e : A := p * (bJ : A) * (aK : A)
      have heK : e ∈ K.toNonUnitalStarSubalgebra := by
        have hba : (bJ : A) * (aK : A) ∈ K.toNonUnitalStarSubalgebra :=
          K.mul_mem_left (bJ : A) aK.2
        simpa only [e, mul_assoc] using K.mul_mem_left p hba
      have heJ : e ∈ Jp := hKp heK
      let eJ : Jp := ⟨e, heJ⟩
      have heJprod : eJ = pJ * bJ * aJ := by
        apply Subtype.ext
        rfl
      have heval : rho eJ z = v := by
        rw [heJprod, map_mul, map_mul]
        change rho pJ (rho bJ (rho aJ z)) = v
        rw [hbJ]
        change rho pJ (S w) = v
        rw [hSw, hvfix]
      have he0 : e ≠ 0 := by
        intro he
        have heJ0 : eJ = 0 := by
          apply Subtype.ext
          exact he
        have : rho eJ z = 0 := by rw [heJ0, map_zero, ContinuousLinearMap.zero_apply]
        exact hv0 (heval.symm.trans this)
      let d : A := e * star e
      have hdK : d ∈ K.toNonUnitalStarSubalgebra := by
        have hstar : star e ∈ K.toNonUnitalStarSubalgebra :=
          StarMemClass.star_mem heK
        exact K.toNonUnitalStarSubalgebra.mul_mem heK hstar
      have hd0 : d ≠ 0 := by
        intro hd
        exact he0 ((CStarRing.mul_star_self_eq_zero_iff e).mp hd)
      have hpe : p * e = e := by
        dsimp only [e]
        calc
          p * (p * (bJ : A) * (aK : A)) =
              (p * p) * (bJ : A) * (aK : A) := by simp only [mul_assoc]
          _ = p * (bJ : A) * (aK : A) := by
            rw [hp.isStarProjection.isIdempotentElem.eq]
      have hstarEp : star e * p = star e := by
        have h := congrArg star hpe
        simpa [star_mul, hp.isStarProjection.isSelfAdjoint.star_eq] using h
      have hdCorner : p * d * p = d := by
        dsimp only [d]
        calc
          p * (e * star e) * p = (p * e) * (star e * p) := by
            simp only [mul_assoc]
          _ = e * star e := by rw [hpe, hstarEp]
      obtain ⟨scalar, hscalar⟩ :=
        hp.exists_eq_smul_of_mem_corner pi hpi hdCorner
      have hscalar0 : scalar ≠ 0 := by
        intro hzero
        apply hd0
        rw [hscalar, hzero, zero_smul]
      have hscaled : scalar⁻¹ • d ∈ K.toNonUnitalStarSubalgebra :=
        K.toNonUnitalStarSubalgebra.smul_mem scalar⁻¹ hdK
      simpa [hscalar, smul_smul, inv_mul_cancel₀ hscalar0] using hscaled

namespace MinimalClosedStarIdeal

/-- Every member of the canonical minimal-ideal family contains an ambient
minimal projection which generates that member, and the resulting cyclic
representation is an actual exact compact-operator model. -/
theorem exists_generator_compactOperatorModel
    (i : MinimalClosedStarIdeal A)
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) :
    ∃ p : A,
      p ∈ i.1.toNonUnitalStarSubalgebra ∧
      IsMinimalStarProjection p ∧
      closedIdealGeneratedBy p = i.1 ∧
      ∃ x : H, x ≠ 0 ∧ pi p x = x ∧
        IsCompactOperatorModel
          (pi.restrictClosedIdealGeneratedByCyclic p x) := by
  obtain ⟨p, hpI, hpmin, hle, x, hx0, hpx, hmodel⟩ :=
    exists_isMinimalStarProjection_generated_subideal_compactOperatorModel
      i.1 pi hpi i.2.isNonzero
  have hgen0 : (closedIdealGeneratedBy p).IsNonzero :=
    exists_ne_zero_mem_closedIdealGeneratedBy hpmin.ne_zero
  have heq : closedIdealGeneratedBy p = i.1 :=
    i.2.eq_of_le hle hgen0
  exact ⟨p, hpI, hpmin, heq, x, hx0, hpx, hmodel⟩

end MinimalClosedStarIdeal

/-- Two distinct minimal nonzero closed ideals multiply to zero in the displayed
order.  A nonzero product would generate a nonzero closed ideal contained in
both, contradicting minimality. -/
theorem mul_eq_zero_of_ne_minimalClosedStarIdeal
    {i j : MinimalClosedStarIdeal A} (hij : i ≠ j)
    {x y : A} (hx : x ∈ i.1.toNonUnitalStarSubalgebra)
    (hy : y ∈ j.1.toNonUnitalStarSubalgebra) :
    x * y = 0 := by
  by_contra hxy0
  let K : ClosedStarIdeal A := closedIdealGeneratedBy (x * y)
  have hKI : K.toNonUnitalStarSubalgebra ≤ i.1.toNonUnitalStarSubalgebra := by
    apply closedIdealGeneratedBy_le (x * y) i.1
    exact i.1.mul_mem_right y hx
  have hKJ : K.toNonUnitalStarSubalgebra ≤ j.1.toNonUnitalStarSubalgebra := by
    apply closedIdealGeneratedBy_le (x * y) j.1
    exact j.1.mul_mem_left x hy
  have hK0 : K.IsNonzero :=
    exists_ne_zero_mem_closedIdealGeneratedBy hxy0
  have hKi : K = i.1 := i.2.eq_of_le hKI hK0
  have hKj : K = j.1 := j.2.eq_of_le hKJ hK0
  apply hij
  apply Subtype.ext
  exact hKi.symm.trans hKj

/-- The canonical family of all minimal nonzero closed ideals is mutually
orthogonal in both multiplication orders. -/
theorem pairwise_orthogonal_minimalClosedStarIdealFamily :
    Pairwise fun i j : MinimalClosedStarIdeal A =>
      (∀ ⦃x y : A⦄,
        x ∈ i.1.toNonUnitalStarSubalgebra →
        y ∈ j.1.toNonUnitalStarSubalgebra → x * y = 0) ∧
      (∀ ⦃x y : A⦄,
        x ∈ i.1.toNonUnitalStarSubalgebra →
        y ∈ j.1.toNonUnitalStarSubalgebra → y * x = 0) := by
  intro i j hij
  constructor
  · intro x y hx hy
    exact mul_eq_zero_of_ne_minimalClosedStarIdeal hij hx hy
  · intro x y hx hy
    exact mul_eq_zero_of_ne_minimalClosedStarIdeal hij.symm hy hx

end MathlibAnnex.Analysis.CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

/-- The submodule of actual finite sums of elements drawn from a family of
closed star ideals.  The `iSup` is algebraic: membership is generated by finite
addition and scalar multiplication, with no closure operation. -/
def closedStarIdealFiniteSumSubmodule {ι : Type*}
    (J : ι → ClosedStarIdeal A) : Submodule ℂ A :=
  ⨆ i, (J i).toNonUnitalStarSubalgebra.toSubmodule

/-- Each summand embeds into the actual finite-sum submodule. -/
theorem mem_closedStarIdealFiniteSumSubmodule_of_mem
    {ι : Type*} (J : ι → ClosedStarIdeal A) (i : ι) {x : A}
    (hx : x ∈ (J i).toNonUnitalStarSubalgebra) :
    x ∈ closedStarIdealFiniteSumSubmodule J :=
  (le_iSup (fun k => (J k).toNonUnitalStarSubalgebra.toSubmodule) i) hx

/-- A displayed finite sum of elements from displayed family members belongs
to the algebraic finite-sum submodule. -/
theorem sum_mem_closedStarIdealFiniteSumSubmodule
    {ι : Type*} (J : ι → ClosedStarIdeal A) (s : Finset ι)
    (x : ι → A) (hx : ∀ i ∈ s, x i ∈ (J i).toNonUnitalStarSubalgebra) :
    ∑ i ∈ s, x i ∈ closedStarIdealFiniteSumSubmodule J := by
  exact Submodule.sum_mem _ fun i hi =>
    mem_closedStarIdealFiniteSumSubmodule_of_mem J i (hx i hi)

/-- The `iSup` definition is exactly the linear span of the union of the ideal
carriers.  Consequently its elements are genuine finite linear combinations,
not elements inserted by a norm closure. -/
theorem closedStarIdealFiniteSumSubmodule_eq_span
    {ι : Type*} (J : ι → ClosedStarIdeal A) :
    closedStarIdealFiniteSumSubmodule J =
      Submodule.span ℂ (⋃ i, ((J i).toNonUnitalStarSubalgebra : Set A)) := by
  exact Submodule.iSup_eq_span
    (fun i => (J i).toNonUnitalStarSubalgebra.toSubmodule)

/-- The actual finite sums of members of the canonical minimal-ideal family. -/
def minimalClosedStarIdealFiniteSumSubmodule : Submodule ℂ A :=
  closedStarIdealFiniteSumSubmodule
    (minimalClosedStarIdealFamily (A := A))

/-- Multiplying a member of a minimal ideal on either side remains in the
corresponding summand of the canonical finite-sum submodule. -/
theorem mul_mem_minimalClosedStarIdealFiniteSumSubmodule
    (i : MinimalClosedStarIdeal A) {x : A}
    (hx : x ∈ i.1.toNonUnitalStarSubalgebra) (a : A) :
    a * x ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A) ∧
      x * a ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A) := by
  constructor
  · exact mem_closedStarIdealFiniteSumSubmodule_of_mem
      (minimalClosedStarIdealFamily (A := A)) i
      (i.1.mul_mem_left a hx)
  · exact mem_closedStarIdealFiniteSumSubmodule_of_mem
      (minimalClosedStarIdealFamily (A := A)) i
      (i.1.mul_mem_right a hx)

namespace NonUnitalCStarRepresentation

/-- Right multiplication by a source projection of finite represented rank
belongs to an actual finite sum of minimal ideals.  Strong induction on the
represented rank repeatedly removes an ambient minimal subprojection; the
rank drops strictly because faithfulness identifies source projections from
their represented ranges. -/
theorem mul_mem_minimalClosedStarIdealFiniteSumSubmodule_of_projection
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) (a : A) {q : A}
    (hq : IsStarProjection q)
    (hqfin : FiniteDimensional ℂ (LinearMap.range (pi q).toLinearMap)) :
    a * q ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A) := by
  induction hqn : pi.projectionRangeRank q using Nat.strong_induction_on generalizing q with
  | _ n ih =>
      by_cases hq0 : q = 0
      · simp [hq0]
      obtain ⟨p, hpmin, hpq, hpfin⟩ :=
        pi.exists_isMinimalStarProjection_le hpi.1 hq hq0 hqfin
      let i : MinimalClosedStarIdeal A :=
        ⟨closedIdealGeneratedBy p,
          isMinimalNonzero_closedIdealGeneratedBy pi hpi hpmin⟩
      have hap : a * p ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A) := by
        apply mem_closedStarIdealFiniteSumSubmodule_of_mem
          (minimalClosedStarIdealFamily (A := A)) i
        exact (closedIdealGeneratedBy p).mul_mem_left a
          (self_mem_closedIdealGeneratedBy p)
      by_cases hpqEq : p = q
      · subst q
        exact hap
      let r : A := q - p
      have hrProj : IsStarProjection r := by
        exact (hpmin.isStarProjection.le_iff_sub hq).1 hpq
      have hqpMul : q * p = p :=
        (hpmin.isStarProjection.le_iff_mul_eq_right hq).1 hpq
      have hqr : q * r = r := by
        dsimp only [r]
        rw [mul_sub, hq.isIdempotentElem.eq, hqpMul]
      have hrq : r ≤ q :=
        (hrProj.le_iff_mul_eq_right hq).2 hqr
      have hrfin : FiniteDimensional ℂ
          (LinearMap.range (pi r).toLinearMap) :=
        pi.finiteDimensional_range_of_starProjection_le hq hrProj hrq hqfin
      have hrne : r ≠ q := by
        intro heq
        apply hpmin.ne_zero
        dsimp only [r] at heq
        exact sub_eq_self.mp heq
      have hrangeLe : LinearMap.range (pi r).toLinearMap ≤
          LinearMap.range (pi q).toLinearMap :=
        pi.range_le_range_of_starProjection_le hq hrProj hrq
      have hrangeNe : LinearMap.range (pi r).toLinearMap ≠
          LinearMap.range (pi q).toLinearMap := by
        intro heq
        exact hrne
          (pi.eq_of_range_eq_of_isStarProjection hpi.1 hrProj hq heq)
      have hrangeLt : LinearMap.range (pi r).toLinearMap <
          LinearMap.range (pi q).toLinearMap :=
        lt_of_le_of_ne hrangeLe hrangeNe
      letI : FiniteDimensional ℂ (LinearMap.range (pi q).toLinearMap) := hqfin
      have hrank : pi.projectionRangeRank r < pi.projectionRangeRank q := by
        unfold projectionRangeRank
        exact Submodule.finrank_lt_finrank_of_lt hrangeLt
      have hrankN : pi.projectionRangeRank r < n := by
        simpa only [hqn] using hrank
      have harn : a * r ∈
          minimalClosedStarIdealFiniteSumSubmodule (A := A) :=
        ih (pi.projectionRangeRank r) hrankN hrProj hrfin rfl
      have hqsum : q = p + r := by
        dsimp only [r]
        abel
      rw [hqsum, mul_add]
      exact (minimalClosedStarIdealFiniteSumSubmodule (A := A)).add_mem hap harn

/-- Every source element admits norm approximation by an actual finite sum of
members of the canonical minimal-ideal family.  The approximation is obtained
by applying the finite-rank spectral cutoff to `star a * a` and using the
C-star identity; no maximal family or annihilator argument occurs. -/
theorem exists_mem_minimalClosedStarIdealFiniteSumSubmodule_norm_sub_lt
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) (a : A)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ y ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A),
      ‖a - y‖ < ε := by
  let b : A := star a * a
  have hb : 0 ≤ b := star_mul_self_nonneg a
  have hεsq : 0 < ε ^ 2 := sq_pos_of_pos hε
  obtain ⟨q, hq, hqfin, hcomm, hcut⟩ :=
    pi.exists_finite_rank_spectral_projection_norm_sub_mul_lt
      hpi b hb hεsq
  let y : A := a * q
  have hy : y ∈ minimalClosedStarIdealFiniteSumSubmodule (A := A) :=
    pi.mul_mem_minimalClosedStarIdealFiniteSumSubmodule_of_projection
      hpi a hq hqfin
  have hqSelf : star q = q := hq.isSelfAdjoint.star_eq
  have hqIdem : q * q = q := hq.isIdempotentElem.eq
  have hstar : star (a - y) * (a - y) = b - b * q := by
    dsimp only [y, b]
    rw [star_sub, star_mul, hqSelf]
    have hcommEq : (star a * a) * q = q * (star a * a) := hcomm.eq
    have hqBq : q * (star a * a) * q = (star a * a) * q := by
      calc
        q * (star a * a) * q = ((star a * a) * q) * q := by rw [hcommEq]
        _ = (star a * a) * (q * q) := mul_assoc _ _ _
        _ = (star a * a) * q := by rw [hqIdem]
    calc
      (star a - q * star a) * (a - a * q) =
          star a * a - (star a * a) * q - q * (star a * a) +
            q * (star a * a) * q := by noncomm_ring
      _ = star a * a - (star a * a) * q := by
        rw [hqBq, ← hcommEq]
        abel
  have hsquare : ‖a - y‖ * ‖a - y‖ < ε ^ 2 := by
    rw [← CStarRing.norm_star_mul_self, hstar]
    simpa only [b] using hcut
  have hnorm : ‖a - y‖ < ε := by
    nlinarith [norm_nonneg (a - y)]
  exact ⟨y, hy, hnorm⟩

end NonUnitalCStarRepresentation

/-- The actual algebraic finite sums of the canonical pairwise orthogonal
minimal elementary ideals are norm dense.  This is the finite-sum density
statement needed before constructing the eventual `c₀` assembly. -/
theorem dense_minimalClosedStarIdealFiniteSumSubmodule
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) :
    Dense (minimalClosedStarIdealFiniteSumSubmodule (A := A) : Set A) := by
  rw [Metric.dense_iff]
  intro a ε hε
  obtain ⟨y, hy, hay⟩ :=
    pi.exists_mem_minimalClosedStarIdealFiniteSumSubmodule_norm_sub_lt
      hpi a hε
  refine ⟨y, ?_, hy⟩
  simpa only [Metric.mem_ball, dist_eq_norm, norm_sub_rev] using hay

/-- Equivalent closure form of the preceding quantitative norm-density
result. -/
theorem topologicalClosure_minimalClosedStarIdealFiniteSumSubmodule_eq_top
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) :
    (minimalClosedStarIdealFiniteSumSubmodule (A := A)).topologicalClosure = ⊤ :=
  Submodule.dense_iff_topologicalClosure_eq_top.mp
    (dense_minimalClosedStarIdealFiniteSumSubmodule pi hpi)

end MathlibAnnex.Analysis.CStarAlgebra
